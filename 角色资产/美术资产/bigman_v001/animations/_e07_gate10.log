≈ 1 mm。判据 = 预蓄帧拳心 y ≥ 0.10 m（在身后）。★ 旋钮 ⑤ `FRONT_WINDUP` 把预蓄照抄成 E06 的向前 ⟹ 变红。", "v2_hitstop_frames": 4, "v2_hitstop_windows": [[34, 37]], "v2_hitstop_steps_deg": {"34": [{"from": 34, "step_deg": 0.514893, "at": [35, "hand.L"]}, {"from": 35, "step_deg": 0.000722, "at": [36, "hand.L"]}, {"from": 36, "step_deg": 1.6e-05, "at": [37, "hand.R"]}]}, "v2_hitstop_worst_step_deg": 0.514893, "v2_hitstop_ok": false, "v2_hitstop_note": "★★ 「举到位」的那一刻有**打击停顿**：窗口 [[34, 37]] 共 4 帧内逐帧姿态冻结（`max |Δ euler|` 实测 **0.514893°**，阈值 ≤ 0.01）。★ 与 E06 的**三窗口**不同：本支是**单窗口**（清单 §1 第 4 维度）；靠 `A.set_hitstop` 把窗口键设 CONSTANT，帧号前进而姿态不变。★ 旋钮 ⑥ `NO_HITSTOP` **真抽掉键表 `hold` 行**（非惰性）。", "v2_chest_rx_deg": {"76": -2.9, "88": -2.8}, "v2_chest_puff_max_rx_deg": -2.5, "v2_chest_puff_ok": true, "v2_chest_puff_note": "★★ 「胜利」的躯干载体是**挺胸**（`chest rx` **负** = 后仰挺胸）。实测庆祝段（f=[76, 88]）`chest rx` = {'76': -2.9, '88': -2.8}（**必须全部 ≤ -2.5°**）。★ 旋钮 ⑦ `SLUMP` 把胸拨成前倾（+3°）⟹ 变红。", "v2_head_back_deg": {"34": 12.0, "46": 10.6, "54": 12.7, "76": 16.5, "88": 16.2, "108": 0.7}, "v2_head_back_peak_deg": 16.5, "v2_chin_range": [8.0, 24.0], "v2_no_roar_max_deg": 26.0, "v2_chin_up_ok": true, "v2_no_roar_ok": true, "v2_chin_up_note": "★★ 「胜利」的头部载体是**下巴上扬**（`head_back` 正 = 后仰 / 上扬）。实测庆祝段峰值 **16.5°**（区间 8~24）；全程峰值 **16.5°**（⟹ 不怒吼，≤ 26°；E03 `Rage` 是 36.0°）。★ 旋钮 ⑧ `NO_CHIN` 清零颈/头增量 ⟹ 变红。", "v2_hero_window": [76, 88], "v2_hero_frames": 13, "v2_hero_min_frames": 8, "v2_hero_steps_deg": [{"from": 76, "step_deg": 0.009495, "at": [77, "hand.L"]}, {"from": 77, "step_deg": 0.020494, "at": [78, "upperarm.L"]}, {"from": 78, "step_deg": 0.030989, "at": [79, "upperarm.L"]}, {"from": 79, "step_deg": 0.038765, "at": [80, "upperarm.L"]}, {"from": 80, "step_deg": 0.04401, "at": [81, "upperarm.L"]}, {"from": 81, "step_deg": 0.046602, "at": [82, "upperarm.L"]}, {"from": 82, "step_deg": 0.048016, "at": [83, "forearm.L"]}, {"from": 83, "step_deg": 0.043657, "at": [84, "upperarm.L"]}, {"from": 84, "step_deg": 0.040788, "at": [85, "upperarm.L"]}, {"from": 85, "