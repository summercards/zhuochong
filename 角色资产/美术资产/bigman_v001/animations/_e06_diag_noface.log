gap_mm": -16.08}, "sym_L_x": 88.62, "R": {"core_mm": [-89.47, -302.56, 1199.14], "core_gap_mm": 31.0, "knuckle_gap_mm": -16.451}, "sym_R_x": 89.47}, "72": {"L": {"core_mm": [330.0, -326.0, 1392.0], "core_gap_mm": 255.1, "knuckle_gap_mm": 208.061}, "sym_L_x": 330.0, "R": {"core_mm": [-330.0, -326.0, 1392.0], "core_gap_mm": 255.21, "knuckle_gap_mm": 207.706}, "sym_R_x": 330.0}}, "victory_pound_knuckle_worst_mm": -15.92, "victory_pound_knuckle_deepest_mm": -16.451, "victory_pound_contact_max_mm": 8.0, "victory_pound_contact_ok": true, "victory_pound_pierce_max_mm": 10.0, "victory_pound_pierce_ok": false, "victory_pound_contact_note": "★★★ **本支命门**：「捶胸」= 拳**面**（指节 `Finger_*` 顶点）砸在胸面上。判据 = **指节面到躯干面的最小带符号距离**（真·网格量，不是球近似）：贴合 ⟹ 最大值 ≤ 8.0 mm（三捶的 6 个定格帧全部要满足）；不穿透 ⟹ 最小值 ≥ −10.0 mm。实测定格窗（[[26, 28], [40, 42], [54, 56]]）内 最松 **-15.92 mm** / 最深 **-16.451 mm**。★ 与 E05 `bstart_fist_contact_ok`（拳 vs **拳**）不同：本支是「拳 vs **躯干**」，与 E03 `rage_chest_hit_ok` 同族 —— 但**捶点更高**（见 `victory_pound_site_ok`）。", "victory_pound_sym_rows": {"26": {"x": 0.85, "y": 0.23, "z": 0.13}, "40": {"x": 0.85, "y": 0.23, "z": 0.13}, "54": {"x": 0.85, "y": 0.23, "z": 0.13}}, "victory_pound_sym_worst_mm": {"x": 0.85, "y": 0.23, "z": 0.13}, "victory_pound_sym_limits_mm": [20.0, 25.0, 25.0], "victory_pound_sym_ok": true, "victory_pound_sym_note": "★ **三捶的同步性**：「双拳同时捶胸」两拳必须**同时、同高、同深** —— 一高一低 / 一前一后会被读成「一只手在挠痒」。实测三捶（f=[26, 40, 54]）的拳心镜像偏差 **x 0.85 / y 0.23 / z 0.13 mm**（≤ 20 / 25 / 25）。★ 本支 `ry ≡ 0`（不拧腰），对称由**结构**保证，不是靠调参。", "victory_pound_site_rows": {"26": {"z_mm": 1199.01, "x_abs_mm": 89.47}, "40": {"z_mm": 1199.01, "x_abs_mm": 89.47}, "54": {"z_mm": 1199.01, "x_abs_mm": 89.47}}, "victory_pound_site_z_min_mm": 1199.01, "victory_pound_site_x_max_mm": 89.47, "victory_pound_site_z_limit_mm": 1255.0, "victory_pound_site_ok": false, "victory_pound_site_note": "★★★ **E06 与 E03 的核心差异（可量化）**：清单预警说「E06 捶胸会与 E03 `Rage` 撞车」，开工实测（`probe_e06_baseline.py`）**推翻了清单的前提** —— E03 **本来就是双拳同时、精确对称**捶胸（`fist_dx = 244.4 mm`，两侧拳面 4.56 / 4.29 mm）。⟹ 差异只能做在**别的维度**上，本支选的是**捶点高度**：E03 实测命中拳心 z = **1166.6 mm**（下胸 / 剑突）；本支实测三捶最低 z = **1199.0 mm**（上胸 / 胸肌，探测点取胸骨下 60 mm）⟹ **高 32.4 mm**。判据：z ≥ 1255 mm（旋钮 ④ `LOW_CHEST` 把探测点拨回 E03 高度 ⟹ 本判据变红）。", "victory_pound_count": 3, "victory_pound_count_ok": true, "victory_pound_count_note": "★ E03 是 **f28 / f52 两捶**（间隔 24 帧）；本支是 **f[26, 40, 54] 三捶**（间隔 14 帧）—— 更快的庆祝节奏，也是与 E03 的第二处可量化差异。", "victory_hitstop_frames": 3, "victory_hitstop_windows": [[26, 28], [40, 42], [54, 56]], "victory_hitstop_steps_deg": {"26": [{"from": 26, "step_deg": 7.441855, "at": [27, "hand.L"]}, {"from": 27, "step_deg": 0.226796, "at": [28, "hand.L"]}], "40": [{"from": 40, "step_deg": 2.220648, "at": [41, "hand.L"]}, {"from": 41, "step_deg": 0.021859, "at": [42, "hand.L"]}], "54": [{"from": 54, "step_deg": 2.220157, "at": [55, "hand.L"]}, {"from": 55, "step_deg": 0.021839, "at": [56, "hand.L"]}]}, "victory_hitstop_worst_step_deg": 7.441855, "victory_hitstop_ok": false, "victory_hitstop_note": "★ 「打击停顿」**每次捶击**都有：判据量**三个定格窗口内逐帧姿态**（`max |Δ euler|`），窗口 [[26, 28], [40, 42], [54, 56]] 各 3 帧，实测窗口内最大逐帧角步 **7.441855°**（阈值 ≤ 0.01° ⟹ 姿态完全冻结）。★ 定格靠**时间轴冻结**（帧号前进、姿态不变 + `A.set_hitstop` 把窗口键设 CONSTANT），**不是**把 N 帧压进插值 —— 否则 `no_snap_stop_ok` 会在定格边界炸。★ 与 E03 的两窗口、E05 的单窗口都不同：本支是**三窗口**。", "victory_chest_rx_deg": {"72": -3.0, "84": -2.5, "94": -2.4}, "victory_chest_puff_max_rx_deg": -2.5, "victory_chest_puff_ok": false, "victory_chest_puff_note": "★★ 「胜利」的躯干载体是**挺胸**（`chest rx` **负** = 后仰挺胸）。实测庆祝段（f=[72, 84, 94]）`chest rx` = {'72': -3.0, '84': -2.5, '94': -2.4}（**必须全部 ≤ -2.5°**）。★ 与 E03 的区别：E03 的胸后仰发生在**怒吼**时（头后仰 36°）；本支是**张臂 + 挺胸 + 下巴只上扬 12~16°** ⟹ 情绪读成「庆祝」而非「愤怒」。★ 旋钮 ⑦ `SLUMP` 把胸拨成前倾（+3°）⟹ 本判据变红。", "victory_head_back_deg": {"26": 7.0, "40": 7.0, "54": 7.0, "72": 16.0, "84": 12.0, "94": 11.7, "108": 0.7}, "victory_head_back_peak_deg": 16.0, "victory_chin_range": [8.0, 24.0], "victory_no_roar_max_deg": 26.0, "victory_chin_up_ok": true, "victory_no_roar_ok": true, "victory_chin_up_note": "★★ 「胜利」的头部载体是**下巴上扬**（`head_back` **正** = 后仰 / 上扬）。实测庆祝段峰值 **16.0°**（区间 8~24）；全程峰值 **16.0°**（⟹ `victory_no_roar_ok`：**不怒吼**，必须 ≤ 26°）。★ 这是与 E03 的第三处可量化差异：E03 怒吼顶 `head_back = 36.0°`。★ 区间**两端卡**：太小 = 没抬头（读不出胜利）；太大 = 变成 E03 的怒吼。★ 旋钮 ⑧ `NO_CHIN` 把颈/头上扬增量清零 ⟹ 本判据变红。", "victory_hero_window": [84, 94], "victory_hero_frames": 11, "victory_hero_min_frames": 8, "victory_hero_steps_deg": [{"from": 84, "step_deg": 0.703423, "at": [85, "hand.L"]}, {"from": 85, "step_deg": 0.019261, "at": [86, "forearm.R"]}, {"from": 86, "step_deg": 0.028359, "at": [87, "forearm.R"]}, {"from": 87, "step_deg": 0.034356, "at": [88, "forearm.R"]}, {"from": 88, "step_deg": 0.03732, "at": [89, "forearm.R"]}, {"from": 89, "step_deg": 0.037252, "at": [90, "forearm.R"]}, {"from": 90, "step_deg": 0.034219, "at": [91, "forearm.R"]}, {"from": 91, "step_deg": 0.028099, "at": [92, "forearm.R"]}, {"from": 92, "step_deg": 0.041835, "at": [93, "upperarm.R"]}, {"from": 93, "step_deg": 0.067405, "at": [94, "hand.L"]}], "victory_hero_worst_step_deg": 0.703423, "victory_hero_hold_ok": true, "victory_hero_hold_note": "★★ 清单风险 2：「胜利动作的停不能太长，末段必须是**稳定的英雄 Pose** 而非颤抖」。判据 = `HERO..HERO_HOLD` 窗口 **f=84~94 共 11 帧**内逐帧最大角步 **0.703423°**（≤ 1.60°/帧 ⟹ 读作「稳住」）。★ 与「定格」的区别：定格是 CONSTANT 插值的**硬冻结**（角步 ≈ 1e−6），本段是**缓动到几乎静止**（HOLD 键与 HERO 键只差 < 0.3°）——语义上是「摆好姿势站定」，不是「被打停了」。★ 旋钮 ⑨ `TREMBLE` 在窗口内逐帧交替 ±3° ⟹ 本判据变红。", "victory_ankle_drift_mm": {"L": 0.0001, "R": 0.0001}, "victory_toe_drift_mm": {"L": 0.0002, "R": 0.0002}, "victory_sole_min_mm": -1.334, "victory_sole_max_mm": -0.962, "foot_lock_ok": true, "foot_lock_note": "★★★ **脚锁「全程」口径**（照 E05；E06 不跳、不位移）：本支双腿全程落地 ⟹ `want` 恒 = 站架踝。实测踝漂 **L 0.0001 / R 0.0001 mm**、趾漂 **L 0.0002 / R 0.0002 mm**（阈值 0.5 mm），鞋底 **-1.33 ~ -0.96 mm**（带 -2 ~ 6）。★ 三捶的**屈膝下沉**全部由腿 IK 吸收，脚一动不动 —— 这正是「捶胸靠屈膝发力」的物理证据（力量链的腿段）。", "no_snap_stop_step_deg": 0.2477, "no_snap_stop_at": [115, "shoulder.R"], "no_snap_stop_ok": true, "seam_first_step_deg": 0.6249, "seam_last_step_deg": 0.0394, "loop_velocity_ok": null, "loop_velocity_note": "★ **停用 `loop_velocity_ok` 并登记理由**：该判据（首/末帧角速度必须相等）是 E02 为**循环**动画加的对称性检查。本支 `meta.loop = false`（**一次性**「胜利」：站架 → 三捶 → 张臂 → 英雄姿 → 回站架），首末帧同姿只用于「起手不留痕」，**不要求角速度对称**。实测首帧步 0.625° / 末帧步 0.039°。", "chain_travel": {"foot_axis_mm": 42.943, "knee_deg": 14.741, "hip_mm": 39.446, "waist_deg": 3.844, "shoulder_mm": 89.715, "hand_mm": 255.53}, "chain_note": "★ 力量传导链 **脚 → 腿 → 髋 → 腰 → 肩 → 手**，六段**都必须有非零关键帧**（清单 0.2「不许跳级」）。本支载体：脚 = 髋↔踝距离行程（下沉靠屈膝）＋ 踝**全程钉死**（漂移 ≤ 0.5 mm）；腿 = 膝屈角行程；髋 = 骨盆世界行程；腰 = `chest` 俯仰行程；肩 = 肩峰世界行程；手 = 拳心世界行程。★ 本支**没有「只有手在动」**：每次捶击的屈膝下沉把脚→腿→髋→腰全部串上。", "chain_present_ok": true, "leg_reach_ratio_max": 0.94267, "leg_reach_at": [0, "L"], "leg_reach_ok": true, "arm_reach_ratio_max": 0.58857, "arm_reach_at": [72, "L"], "arm_reach_ok": true, "clip_max_mm": 0.0, "clip_at": null, "no_face_clip_ok": true, "victory_pierce_scope": ["(0, TOTAL) 内全部帧", "排除接缝帧 [0, 120]"], "victory_pierce_nothumb_worst": 80, "victory_pierce_nothumb_worst_at": [26, "R"], "victory_pierce_nothumb_deepest_mm": -16.47, "victory_pierce_nothumb_deepest_at": [57, "R"], "victory_pierce_all_worst": 82, "victory_pierce_thumb_worst": 73, "victory_station_nothumb_count": 3, "victory_station_pierce": {"L": {"inside": 0, "inside_nothumb": 0, "thumb": 0, "n": 666, "deepest_mm": 1.04, "deepest_nothumb_mm": 29.3}, "R": {"inside": 74, "inside_nothumb": 3, "thumb": 71, "n": 666, "deepest_mm": -33.96, "deepest_nothumb_mm": -4.05}}, "victory_pierce_detail": {"0": {"L": {"inside": 0, "inside_nothumb": 0, "thumb": 0, "n": 666, "deepest_mm": 1.04, "deepest_nothumb_mm": 29.3}, "R": {"inside": 74, "inside_nothumb": 3, "thumb": 71, "n": 666, "deepest_mm": -33.96, "deepest_nothumb_mm": -4.05}}, "3": {"L": {"inside": 13, "inside_nothumb": 0, "thumb": 13, "n": 666, "deepest_mm": -3.56, "deepest_nothumb_mm": 21.69}, "R": {"inside": 82, "inside_nothumb": 9, "thumb": 73, "n": 666, "deepest_mm": -37.02, "deepest_nothumb_mm": -9.12}}, "6": {"L": {"inside": 6, "inside_nothumb": 0, "thumb": 6, "n": 666, "deepest_mm": -2.32, "deepest_no