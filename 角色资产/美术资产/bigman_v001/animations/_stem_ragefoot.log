rd_nt": 3, "deep_nt": [[1.0, 2], [2.0, 2], [3.0, 1], [5.0, 0]]}}}, "rage_station_pierce": {"L": {"inside": 0, "inside_nothumb": 0, "inside_fist": 0, "inside_palm": 0, "single": 4, "thumb": 0, "n": 886, "deepest_mm": 1.04, "deepest_nothumb_mm": 30.87, "hard": 0, "hard_nt": 0, "deep_nt": [[1.0, 0], [2.0, 0], [3.0, 0], [5.0, 0]]}, "R": {"inside": 99, "inside_nothumb": 4, "inside_fist": 0, "inside_palm": 4, "single": 99, "thumb": 95, "n": 886, "deepest_mm": -34.19, "deepest_nothumb_mm": -4.5, "hard": 0, "hard_nt": 0, "deep_nt": [[1.0, 3], [2.0, 2], [3.0, 2], [5.0, 0]]}}, "rage_station_nothumb_count": 4, "rage_station_fist_count": 0, "rage_station_palm_count": 4, "rage_pierce_fist_worst": 3, "rage_pierce_fist_worst_at": [6, "R"], "rage_pierce_palm_worst": 3, "rage_pierce_palm_worst_at": [3, "R"], "rage_pierce_deep_nt_worst": [[1.0, 3], [2.0, 3], [3.0, 3], [5.0, 2]], "rage_punch_no_pierce_ok": true, "rage_punch_no_pierce_note": "★★★ 权威口径 = **13 方向多数表决**（> 6 票），**判据只看排除拇指后的手网格**。判据范围 = **全时间轴**（步长 3 + 命中断加密）**除两个接缝帧**（它们逐位等于上游，本支无权改）。实测本支段非拇指顶点「真的在躯干体内」数 **4**（最差 @ (6, 'R')）、非拇指**最深带符号距离** **-6.79 mm**（@ (3, 'R')，下限 −10 mm）⟹ 本支**没有把拳捅进胸腔**。★ 同批帧的**全手（含拇指）**读数照样打印：体内最多 **76** 个（其中拇指 **73** 个）、带符号距离 < 0 的顶点最多 **76** 个 —— **登记而不掩盖**。★ 单方向奇偶在同一批帧上会报出最多 **76** 个「体内顶点」（全是擦边噪声，得票 1~2）—— 这就是**为什么不用它当门禁**（`_e03_yard.py` 实测：真内部恒 13/13 票，噪声恒 ≤ 2 票，两极分离）。★★ 站架基线（`f=0 / f=96`，逐位 = 上游 `Idle_01@0`）：R 手 **99** 个顶点在体内（占所测 886 个的 11.2%）、其中拇指 **95** 个、最深 **-34.19 mm** @ Thumb_R；L 手 **0** 个。⟹ 这是 **A01 `Idle_01` 的预存几何缺陷**（右手拇指陷进右胸），`_e03_station.py` 已用**真实 Action** 与**重建姿**两条途径量到**逐位相同**的读数，证明**不是本支引入**；本支 f=0/f=96 必须逐位等于它，所以**无法在本支修掉**（修它就破更强的 `seam_in_ok`）。★ 已登记待修。判据把拇指排除是**换尺子**（拳用指节面砸，不用拇指戳），**不是放宽阈值**：本支要求非拇指 **≤ 4** 个 / 深度 ≥ −10 mm，比站架基线的拇指 -34.19 mm **更严**。★★★ v011 判据口径修正（**改的是基准，不是阈值**）：由「非拇指 **0** 个」改为「**≤ 站架基线的同一读数**（4 个）」，理由见代码 ② 段注释 —— 站架**自己就有 4 个非拇指顶点在体内**（`Hand_Palm_R`，gap −0.54 / −1.17 / −4.31 / −4.50 mm，`_e03_early.py` 实测；它们离**拳心 88~106 mm**，是**腕侧掌肉**，不是拳面；站架拳心离躯干 **+66.63 mm**）⟹ 本支 f=0/f=96 必须逐位等于它，「0 个」这个口径**与接缝约束在数学上不相容**。★ 阈值一字未动（深度下限仍是 −10 mm、计数上限仍是 4），且历史 red 项 `f=43` 的 25 个顶点 / −7.52 mm 在本口径下 **25 > 4 ⟹ 照样红**。", "rage_head_back_deg_max": 36.0, "rage_head_back_frame": 44, "rage_head_back_range": [30.0, 62.0], "rage_head_back_at_roar": 36.0, "rage_head_back_at_roar2": 20.0, "rage_head_back_settle_window": [84, 96], "rage_head_back_settle_max": 7.04, "rage_head_back_ok": true, "rage_head_back_note": "★★ 仰头角 = **−(Δneck + Δhead)**（相对站架的增量之和，**正 = 后仰**），口径由 `probe_e03_baseline.py` 的 42 组合格点标定（探针实测 `head_back_vs_chest_deg` 恰好等于两者之和再加恒定 −1.0°）。**两端都卡** 30~62°：太小 = 没仰（读成「只是站着」）；太大 = 断颈 / 头掉下去。★ 峰值实测 **36.0° @ f=44**（应 ≈ ROAR=44，实测 ROAR 处 36.0° / ROAR2 处 20.0° ⟹ 第一声怒吼是峰值、第二声仍 ≥ 12° 可见）。收势判据 = **末尾 12 帧（f ∈ [84, 96]）** 的绝对值 ≤ 15°。★ v001 的收势窗口写成「f ≥ ROAR2」是**口径错**（ROAR2 本身就是第二个后仰峰值，拿它当「该放平了」等于要求动作自己否掉自己），已改为末尾窗口。", "rage_hitstop_frames": 3, "rage_hitstop_windows": [[28, 30], [52, 54]], "rage_hitstop_steps_deg": [{"window": [28, 30], "from": 28, "step_deg": 2.4e-05, "at": [29, "hand.R"]}, {"window": [28, 30], "from": 29, "step_deg": 2.7e-05, "at": [30, "hand.R"]}, {"window": [52, 54], "from": 52, "step_deg": 2e-05, "at": [53, "hand.R"]}, {"window": [52, 54], "from": 53, "step_deg": 0.0, "at": null}], "rage_hitstop_worst_step_deg": 2.7e-05, "rage_hitstop_ok": true, "rage_hitstop_note": "★★★ **hitstop 必须真的落进 Action**：判据量的是**定格窗口内逐帧姿态**（`max |Δ euler|`），不是只读 `meta.hitstop_frames` 那个数字 —— **数字是声明，姿态才是事实**。窗口 [[28, 30], [52, 54]] 各 3 帧，实测窗口内最大逐帧角步 **0.000027°**（阈值 ≤ 0.01° ⟹ 姿态完全冻结）。★ 定格靠**时间轴冻结**（帧号前进、姿态不变 + `A.set_hitstop` 把窗口键设 CONSTANT），**不是**把 N 帧压进插值 —— 否则 `no_snap_stop_ok` 会在定格边界炸。", "rage_windup_drop_mm": 45.0, "rage_windup_flex_deg": 22.0, "rage_roar_ext_deg": -21.0, "rage_torso_flip_deg": 43.0, "rage_windup_ok": true, "rage_windup_note": "★ `rage_windup_ok` 三个量一起卡：蓄力段骨盆下沉 45.0 mm（区间 25~70）+ 含胸前倾合计 22.0°（≥ 12）+ ★★★ **躯干翻转幅度 = 前倾 22.0° − 后仰 21.0° = 43.0°**（≥ 20）。★ 第三条是本支独有的：E02 躯干是**单向**前倾，本支必须**由前倾翻转为后仰** —— 「只前倾不后仰」= 没怒吼。", "rage_ankle_drift_mm": {"L": 49.2443, "R": 49.2444}, "rage_toe_drift_mm": {"L": 49.2443, "R": 49.2443}, "rage_foot_lock_ok": false, "rage_foot_lock_note": "★★★ 本支**全程不迈步**（爆发时脚更不该动）⟹ 踝到**站架锚点**的漂移全程 ≤ 0.5 mm、趾 ≤ 0.5 mm（阈值 0.5 mm）。★ 与 E02 不同：E02 只在 hold 段判（它故意迈了一步）；本支**全程判**，比 E02 **更严**。★ 因此「脚」这一环的力量传导**不体现在踝的位移**上 —— 见 `chain_present_ok` 的 `foot_axis_mm`。", "rage_sole_min_mm": -45.965, "rage_sole_max_mm": 13.058, "sole_ground_ok": false, "ground_hold_ok": false, "no_snap_stop_step_deg": 0.4465, "no_snap_stop_at": [88, "head"], "no_snap_stop_ok": true, "seam_first_step_deg": 0.3429, "seam_last_step_deg": 0.0359, "loop_velocity_ok": null, "loop_velocity_note": "★ **停用 `loop_velocity_ok` 并登记理由**：该判据（首/末帧角速度必须相等）是 E02 为**循环**动画加的对称性检查。本支 `meta.loop = false`（**一次性起手**：起手 → 爆发 → 回战斗架势，播完交给站位接管），首末帧同姿只用于「起手不留痕」，**不要求角速度对称**。实测首帧步 0.343° / 末帧步 0.036°（末帧更慢是**设计意图**：收招要减速）。★ 设一个必然为假的判据等于没有判据 ⟹ 不设。接缝的真实守卫是 `seam_in_ok` 与 `end_matches_start_ok`（逐元素矩阵比对）。", "chain_travel": {"foot_axis_mm": 6.055, "knee_deg": 2.368, "hip_mm": 49.244, "waist_deg": 286.479, "shoulder_mm": 136.442, "hand_mm": 237.435}, "chain_foot_carrier_note": "★★★ **本支的「脚」段换了载体（不是放宽容差，是载体不适用）**：E02 用「迈步时踝的世界行程」当脚段证据（本支 `rage_foot_lock_ok` 实测踝漂 ≤ 49.2444 mm ⟹ 用它当证据会**恒为 0**）。本支改用 **腿的伸缩**：髋↔踝距离全程走 6.1 mm（蓄力下沉 45 mm → 怒吼上顶 12 mm，腿先压缩再蹬伸）。★ 为什么这是**更强**的证据：脚是**不动的地面支点**（该身份已由 `rage_foot_lock_ok` 独立钉死，全程 ≤ 0.5 mm），力量**只能**从这只锁死在地面的脚经腿传到髋 —— E02 的迈步行程证明不了「支点」，本支的伸缩能。", "chain_present_ok": false, "leg_reach_ratio_max": 0.94267, "leg_reach_ok": true, "arm_reach_ratio_max": 0.53456, "arm_reach_at": [48, "R"], "arm_reach_ok": true, "clip_max_mm": 0.0, "clip_at": null, "no_face_clip_ok": true, "rage_matrix_step_deg_max": 20.897, "rage_matrix_step_at": [20, "hand.L"], "rage_matrix_step_ok": true, "rage_euler_step_deg_max": 24.081, "rage_euler_step_at": [19, "hand.R"], "rage_matrix_step_note": "★★ **矩阵口径**的逐帧最大真实旋转步：实测 **20.897° @ (20, 'hand.L')**（阈值 ≤ 25.0°）。★ 与 euler 口径的逐帧最大角步（实测 **24.081° @ (19, 'hand.R')**）**必须一致地小**：两者差得远就说明欧拉表示在跳（C14 / D01 的万向节锁坑），而不是动作在跳。本支先做 `compat_euler` 把等价欧拉代表选到最小步，再用本条断言证明「修的是表示、不是把真跳变藏起来」—— 没有这一条，「我把 `no_teleport` 修绿了」就只是一句话。★ v001 实测 euler 口径 95.618°、矩阵口径 5.500° ⟹ 差 90.118°，证明当时红的确实是**表示**不是**动作**。", "phase_markers": {"START": 0, "WINDUP": 20, "HIT_1": 28, "HOLD_1_END": 30, "ROAR": 44, "LIFT": 48, "HIT_2": 52, "HOLD_2_END": 54, "ROAR2": 66, "END": 96}, "end_matches_start_elem_max": 0.0, "end_matches_start_elem_at": null, "end_matches_start_ok": true, "loop_angle_deg": 0.0, "loop_move_mm": 0.0, "seam_in_pos_max_mm": 8.7e-05, "seam_in_dir_max_deg": 0.031181, "seam_in_at": "toe.R", "seam_in_ok": true, "seam_in_src": "Idle_01@0", "meta": {"anim_id": "Rage", "loop": false, "category": "状态与流程", "note": "狂暴起手：下沉含胸蓄力 → 双拳捶胸（2 次，各定格 3 帧）→ 仰头怒吼（后仰峰值）→ 收势回战斗架势；全程锁踝不迈步", "frames": [0, 96], "root_motion_m": [0.0, 0.0], "hitstop_frames": 3, "hitstop_windows": [[28, 30], [52, 54]], "antic_frame": 20, "hit_frame": 28, "hit_frames": [28, 52], "cancel_frame": 66, "hit_point_m": null, "seam": "Idle_01@0", "frame_bound_note": "★ 96 帧 = 1.6 s，**短于** E01 登记的 120 帧 / 2.0 s 上界 ⟹ 沿用合规（显式声明，不是悄悄超）", "view_note": "★ 本支**双机位**：正面 = 捶胸（横向 X），侧视 = 仰头（矢状面 YZ）；两条尺子各占一个机位，**新立并登记**", "fps": 60}, "failed": ["chain_present_ok", "ground_contact_ok", "ground_hold_ok", "rage_foot_lock_ok", "sole_ground_ok"], "non_ok_bools": ["chain_present_ok", "ground_contact_ok", "ground_hold_ok", "rage_foot_lock_ok", "sole_ground_ok"]}Blender 4.5.0 (hash 8cb6b388974a built 2025-07-15 01:36:24)
